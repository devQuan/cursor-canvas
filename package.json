{
  "name": "cursor-canvas",
  "displayName": "Cursor Canvas",
  "description": "Embedded Cursor panel with live build preview for apps, games, and video",
  "version": "0.1.0",
  "publisher": "devQuan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devQuan/cursor-canvas"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorCanvas.openPanel",
        "title": "Open Canvas Panel",
        "category": "Cursor Canvas"
      }
    ],
    "configuration": {
      "title": "Cursor Canvas",
      "properties": {
        "cursorCanvas.outputFolder": {
          "type": "string",
          "default": null,
          "description": "Video output folder path for frame and video detection"
        },
        "cursorCanvas.estimatedFrameCount": {
          "type": "number",
          "default": 60,
          "description": "Estimated total frames for progress bar"
        },
        "cursorCanvas.portOverride": {
          "type": "number",
          "default": null,
          "description": "Override auto-detected dev server port"
        },
        "cursorCanvas.framePollingIntervalMs": {
          "type": "number",
          "default": 1000,
          "description": "Interval for polling video output folder"
        },
        "cursorCanvas.sceneGraphPath": {
          "type": "string",
          "default": ".cursor-canvas/scene-graph.json",
          "description": "Relative path to the game scene graph JSON dump"
        },
        "cursorCanvas.unityWebGlPath": {
          "type": "string",
          "default": null,
          "description": "Relative path to Unity WebGL build output folder"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:components": "vitest run tests/components",
    "vscode:prepublish": "npm run build",
    "dev:host": "/Applications/Cursor.app/Contents/Resources/app/bin/cursor --extensionDevelopmentPath=\"$PWD\" \"$PWD\"",
    "reinstall": "npm run build && npx @vscode/vsce package && /Applications/Cursor.app/Contents/Resources/app/bin/cursor --install-extension ./cursor-canvas-0.1.0.vsix"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  }
}
